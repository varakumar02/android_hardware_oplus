# Qualcomm diag-router (/vendor/bin/diag-router, stock vendor blob, started by
# /vendor/etc/init/vendor.qti.diag.rc). Qualcomm only ships its policy for
# userdebug/eng (device/qcom/sepolicy_vndr/legacy-um/generic/vendor/test), so a
# user build has no domain for it and init refuses to start it. Same type names
# as Qualcomm's, declared only on user builds so the two never collide.
ifelse(target_build_variant, `user', `
type vendor_diag-router, domain;
type vendor_diag-router_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(vendor_diag-router)

# Peripheral DIAG channels (modem, ADSP, SLPI, CDSP) are QRTR services.
allow vendor_diag-router self:qipcrtr_socket create_socket_perms_no_ioctl;
# Peripheral up/down notifications.
allow vendor_diag-router self:netlink_kobject_uevent_socket create_socket_perms_no_ioctl;
# Ends logging sessions of clients that went away.
allow vendor_diag-router self:capability kill;
# Its HIDL thread waits for hwservicemanager through this property and polls it
# every second while the read is denied; once readable it tries to register
# vendor.qti.diaghal@1.0 once (not in the VINTF manifest, so that fails) and stops.
get_prop(vendor_diag-router, hwservicemanager_prop)
hwbinder_use(vendor_diag-router)
# USB DIAG endpoint (/dev/ffs-diag, mounted by init.qcom.usb.rc). Without it the
# router's USB handle stays half set up and a response routed there crashes it.
allow vendor_diag-router functionfs:dir r_dir_perms;
allow vendor_diag-router functionfs:file rw_file_perms;
allowxperm vendor_diag-router functionfs:file ioctl FUNCTIONFS_ENDPOINT_DESC;
# WLAN (QCA6490) firmware DIAG over MHI, /dev/mhi_*_pipe_4.
allow vendor_diag-router vendor_mhi_diag_device:chr_file rw_file_perms;
')
